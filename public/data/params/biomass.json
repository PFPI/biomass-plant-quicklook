      "plant_mw": {
        "value": 500,
        "label": "Capacity",
        "unit": "MW",
        "note": "Set for each project."
      },
      "green_tons": {
        "label": "Green tons of wood a year",
        "unit": "green tons",
        "note": "Calculated from the plant above; type a number to use a different amount."
      },
      "species": {
        "value": "pine",
        "label": "Type of wood",
        "options": [
          {
            "value": "pine",
            "label": "Pine only"
          },
          {
            "value": "hardwood",
            "label": "Hardwood only"
          },
          {
            "value": "all",
            "label": "Everything"
          }
        ],
        "note": "Which existing harvest the plant is compared with, and where its wood is assumed to come from. Hardwood is all non-pine species."
