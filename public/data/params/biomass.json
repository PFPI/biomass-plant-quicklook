      "clearcut_share": {
        "value": 1,
        "unit": "fraction",
        "label": "Wood from clearcuts",
        "note": "The rest comes from thinnings. Changing one changes the other."
      },
      "thinning_share": {
        "value": 0,
        "unit": "fraction",
        "label": "Wood from thinnings",
        "note": "Thinnings yield far less wood per acre, so more acres are cut."
